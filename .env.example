PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=inventory
DB_PASSWORD=inventory_pass
DB_NAME=inventory_db

# สินค้าที่มีจำนวนน้อยกว่าค่านี้จะถูกนับว่า low stock
LOW_STOCK_THRESHOLD=5

# ตอน deploy: ตั้ง DATABASE_URL เพียงตัวเดียวแทน DB_* (ระบบสร้างตารางให้เองตอนเริ่ม)
# DATABASE_URL=postgres://user:pass@host:5432/dbname
